# Copy to .env (gitignored) next to docker-compose.yml. Every variable is optional.
# Values are placeholders; use your own.

# Root of the pipeline's data: analysis/, history/, logs/, reports/ (and optional config/) live under it. Default ./data
#BMA_DATA_DIR=<data-dir>

# Model weights and caches (PANNs, CLAP, Hugging Face cache). Default ./models
#BMA_MODEL_DIR=<model-dir>

# The board's IPv4 address, for the dashboard's board panel. Unset = panel off.
#BMA_BOARD=<board-ip>

# File holding the board service's bearer token, mounted read-only into the dashboard. Unset = no token.
#BMA_DSPD_TOKEN_FILE=<path-to-token-file>
