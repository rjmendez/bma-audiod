            "minimum": 0,
            "maximum": 1
          },
          "mean_windows": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1
          },
          "concurrent_windows": {
            "type": "integer",
            "minimum": 0
          },
          "adjacent_concurrent_windows": {
            "type": "integer",
            "minimum": 0
          },
          "adjacent_share": {
