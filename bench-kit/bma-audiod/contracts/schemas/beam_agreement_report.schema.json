{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bma:contract:beam-agreement",
  "title": "beam_agreement_report (output of analysis/beam_agreement.py)",
  "description": "One JSON document written by the offline tool analysis/beam_agreement.py: does 'the same species on two beams in the SAME window' tell more than BirdNET's confidence, or only diffuseness? Metadata only, no audio, no coordinates; the shareable form holds group aggregates (species names only with --private-detail, key private_detail). `decision` is computed by the tool from the ordered rules of specs/beam-agreement.md. Readers MUST ignore unknown fields of a later minor version. 1.1.0: optional block shuffle_null (misassociation null of the agreement statistic; report-only).",
  "x-contract-version": "1.1.0",
  "type": "object",
  "required": [
    "k",
    "v",
    "generated_s",
    "input",
    "definition",
    "bins",
    "sensitivity_gap_3s",
    "negative_control",
    "outcomes",
    "decision",
    "reasons"
  ],
  "properties": {
    "k": {
      "const": "beam_agreement_report"
    },
    "v": {
      "const": 1
    },
    "generated_s": {
      "type": "number",
      "description": "Unix seconds; a parameter (--generated-s) so a golden run is reproducible."
    },
    "input": {
      "type": "object",
      "required": [
        "reports",
        "events",
        "gap_s",
        "first_t",
        "last_t",
        "garbage_lines",
        "filtered_skipped",
        "beam_pairs_with_unequal_t",
        "taxa_missing",
        "ambient_records",
        "ambient_garbage",
        "labels"
      ],
      "properties": {
        "reports": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "gap_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "first_t": {
          "type": "number"
        },
        "last_t": {
          "type": "number"
        },
        "garbage_lines": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "beam_pairs_with_unequal_t": {
          "type": "integer",
          "minimum": 0,
          "description": "Consecutive windows of one event whose t differ by under 0.5 s but are not equal: the shared-t_wall assumption is broken when this is > 0."
        },
        "taxa_missing": {
          "type": "integer",
          "minimum": 0
        },
        "ambient_records": {
          "type": "integer",
          "minimum": 0
        },
        "ambient_garbage": {
          "type": "integer",
          "minimum": 0
        },
        "labels": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "n_lines",
                "garbage_lines",
                "unsure_dropped",
                "duplicates",
                "usable"
              ],
              "properties": {
                "n_lines": {
                  "type": "integer",
                  "minimum": 0
                },
                "garbage_lines": {
                  "type": "integer",
                  "minimum": 0
                },
                "unsure_dropped": {
                  "type": "integer",
                  "minimum": 0
                },
                "duplicates": {
                  "type": "integer",
                  "minimum": 0
                },
                "usable": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
