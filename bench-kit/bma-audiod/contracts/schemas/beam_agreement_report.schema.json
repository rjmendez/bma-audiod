            ],
            "minimum": 0,
            "maximum": 1
          },
          "confirmed_nonadjacent": {
            "type": "integer",
            "minimum": 0
          },
          "by_duration": {
            "type": "object",
            "required": [
              "1",
              "2-3",
              ">=4"
            ],
            "properties": {
              "1": {
                "type": "object",
                "required": [
                  "n",
                  "multi_frac"
                ],
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "multi_frac": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              "2-3": {
                "type": "object",
                "required": [
                  "n",
                  "multi_frac"
                ],
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "multi_frac": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              ">=4": {
                "type": "object",
                "required": [
                  "n",
                  "multi_frac"
                ],
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "multi_frac": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
